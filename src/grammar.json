{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "galley",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "rule"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          },
          {
            "type": "STRING",
            "value": "\n"
          }
        ]
      }
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "PATTERN",
          "value": "[^\\n]*"
        }
      ]
    },
    "rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "variable_symbol"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "annotation",
            "content": {
              "type": "SYMBOL",
              "name": "annotation"
            }
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "alternative",
                "content": {
                  "type": "SYMBOL",
                  "name": "alternative"
                }
              },
              {
                "type": "SYMBOL",
                "name": "comment"
              },
              {
                "type": "STRING",
                "value": "\n"
              }
            ]
          }
        }
      ]
    },
    "alternative": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "annotation",
            "content": {
              "type": "SYMBOL",
              "name": "annotation"
            }
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "rhs"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "rhs": {
      "type": "REPEAT1",
      "content": {
        "type": "FIELD",
        "name": "symbol",
        "content": {
          "type": "SYMBOL",
          "name": "symbol_with_procedure"
        }
      }
    },
    "symbol_with_procedure": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "symbol"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "annotation",
            "content": {
              "type": "SYMBOL",
              "name": "annotation"
            }
          }
        }
      ]
    },
    "symbol": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "variable_symbol"
        },
        {
          "type": "SYMBOL",
          "name": "double_quoted_terminal"
        },
        {
          "type": "SYMBOL",
          "name": "raw_quote_terminal"
        },
        {
          "type": "SYMBOL",
          "name": "generative_terminal"
        }
      ]
    },
    "variable_symbol": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "_[A-Z][a-zA-Z0-9_]*"
          },
          {
            "type": "PATTERN",
            "value": "[A-Z][a-zA-Z0-9_]*"
          }
        ]
      }
    },
    "procedure_name": {
      "type": "PATTERN",
      "value": "[a-z][a-zA-Z0-9]*"
    },
    "annotation": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "procedure",
              "content": {
                "type": "SYMBOL",
                "name": "procedure_name"
              }
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "!"
                },
                {
                  "type": "FIELD",
                  "name": "point",
                  "content": {
                    "type": "SYMBOL",
                    "name": "recovery_point"
                  }
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": ">"
                },
                {
                  "type": "FIELD",
                  "name": "marker",
                  "content": {
                    "type": "SYMBOL",
                    "name": "verbatim_marker"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "recovery_point": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "^"
            },
            {
              "type": "FIELD",
              "name": "terminal",
              "content": {
                "type": "SYMBOL",
                "name": "terminal"
              }
            }
          ]
        },
        {
          "type": "PREC",
          "value": 1,
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "FIELD",
                "name": "terminal",
                "content": {
                  "type": "SYMBOL",
                  "name": "terminal"
                }
              },
              {
                "type": "STRING",
                "value": "^"
              }
            ]
          }
        }
      ]
    },
    "verbatim_marker": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": ">"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "^"
            },
            {
              "type": "FIELD",
              "name": "terminal",
              "content": {
                "type": "SYMBOL",
                "name": "terminal"
              }
            }
          ]
        },
        {
          "type": "PREC",
          "value": 1,
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "FIELD",
                "name": "terminal",
                "content": {
                  "type": "SYMBOL",
                  "name": "terminal"
                }
              },
              {
                "type": "STRING",
                "value": "^"
              }
            ]
          }
        }
      ]
    },
    "double_quoted_terminal": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "\\\\u\\{[0-9a-fA-F]+\\}"
              },
              {
                "type": "PATTERN",
                "value": "\\\\x[0-9a-fA-F]+"
              },
              {
                "type": "PATTERN",
                "value": "\\\\."
              },
              {
                "type": "PATTERN",
                "value": "[^\"\\\\]"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "raw_quote_terminal": {
      "type": "PATTERN",
      "value": "\\\\\"~[^~\\n]*~\""
    },
    "generative_terminal": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "generative_name"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "exception"
          }
        }
      ]
    },
    "generative_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "lowercase_letter"
        },
        {
          "type": "STRING",
          "value": "uppercase_letter"
        },
        {
          "type": "STRING",
          "value": "block_start"
        },
        {
          "type": "STRING",
          "value": "block_end"
        },
        {
          "type": "STRING",
          "value": "whitespace"
        },
        {
          "type": "STRING",
          "value": "punctuation"
        },
        {
          "type": "STRING",
          "value": "character"
        },
        {
          "type": "STRING",
          "value": "operator"
        },
        {
          "type": "STRING",
          "value": "new_line"
        },
        {
          "type": "STRING",
          "value": "digit"
        },
        {
          "type": "STRING",
          "value": "hex_digit"
        },
        {
          "type": "STRING",
          "value": "letter"
        },
        {
          "type": "STRING",
          "value": "space"
        },
        {
          "type": "STRING",
          "value": "utf8_lead_two"
        },
        {
          "type": "STRING",
          "value": "utf8_lead_three_general"
        },
        {
          "type": "STRING",
          "value": "utf8_lead_four_general"
        },
        {
          "type": "STRING",
          "value": "utf8_continuation"
        },
        {
          "type": "STRING",
          "value": "utf8_continuation_80_8f"
        },
        {
          "type": "STRING",
          "value": "utf8_continuation_80_9f"
        },
        {
          "type": "STRING",
          "value": "utf8_continuation_90_bf"
        },
        {
          "type": "STRING",
          "value": "utf8_continuation_a0_bf"
        }
      ]
    },
    "exception": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "^"
        },
        {
          "type": "SYMBOL",
          "name": "terminal"
        }
      ]
    },
    "terminal": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "double_quoted_terminal"
        },
        {
          "type": "SYMBOL",
          "name": "raw_quote_terminal"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [
